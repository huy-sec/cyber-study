# ============================================================
# Environment variables for NIST 800-53 Study App
# ============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
#
# For production deployments via GitHub Actions, add these as
# GitHub Secrets (Settings > Secrets and variables > Actions).
# ============================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to use in browser)
# Found in: Supabase Dashboard > Project Settings > API > Project API keys
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
